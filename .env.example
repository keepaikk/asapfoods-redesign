# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
APP_URL="MY_APP_URL"

# Cloudflare R2 Credentials
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="MY_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="MY_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="jovivafoods-images"
R2_PUBLIC_URL="https://pub-<hash>.r2.dev"

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"

# Database Type: json | postgres | firebase
DB_TYPE="json"

# PostgreSQL (only used when DB_TYPE=postgres)
# DATABASE_URL="postgresql://user:pass@localhost:5432/jovivafoods"

# Firebase (only used when DB_TYPE=firebase)
# FIREBASE_PROJECT_ID="my-project"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk@my-project.iam.gserviceaccount.com"
