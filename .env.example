# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloudflare R2 Credentials
# Create bucket at dash.cloudflare.com → R2. Generate API token with Object Read & Write.
R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="MY_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="MY_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="jovivafoods-images"
R2_PUBLIC_URL="https://pub-<hash>.r2.dev"

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"
